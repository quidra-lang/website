int | none | error lookup(int id)
    if id < 0
        return error("invalid id")
    if id == 0
        return none
    return id

auto | error result = lookup(1)
match result
    int value
        print(value)
        print(NL)
    none
        print("none")
        print(NL)
    error problem
        print(problem)
        print(NL)
