class Point(local int x_value, local int y_value)

    int x
    int y
    x = x_value
    y = y_value

    private int sum()
        return x + y

    string describe()
        return "({x}, {y}) sum {sum()}"

Point a = Point(1, 2)
Point b = a
b.x = 9
Point &alias = &a
alias.y = 5
print(a.describe())
print(NL)
print(b.describe())
print(NL)
print("{a == b} {a == Point(1, 5)}")
print(NL)
