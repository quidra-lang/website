class Point
    int x
    int y

    construct(int x_value, int y_value)
        this.x = x_value
        this.y = y_value

    private int sum()
        return this.x + this.y

    string describe()
        return "({this.x}, {this.y}) sum {this.sum()}"

Point a = Point(1, 2)
Point b = a
b.x = 9
Point &alias = &a
alias.y = 5
print(a.describe())
print(NL)
print(b.describe())
print(NL)
print("{a == b} {a == Point(1, 5)}")
print(NL)
