class Point(local int x_value, local int y_value)

    int x
    int y
    x = x_value
    y = y_value

    private int sum()
        return x + y

    string describe()
        return "({x}, {y}) sum {sum()}"

a := Point(1, 2)
b := a
b.x = 9
&alias := &a
alias.y = 5
println(a.describe())
println(b.describe())
println("{a == b} {a == Point(1, 5)}")

class Group(string[] members)
    nat len()
        return #members

group := Group(["Aki", "Yui", "Haru"])
println(#group)
