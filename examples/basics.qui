int count = 3
auto name = "Quidra"
print.line("Hello, {name}")

int[] original = [1, 2, 3]
int[] copy = original
copy[0] = 9
print.line("original[0] = {original[0]}, copy[0] = {copy[0]}")

int total = 0
for auto value = original[]
    total += value
print.line("total = {total}")

for 0 <= int i < count
    if i == 0
        print.line("first")
    elif i < count - 1
        print.line("middle")
    else
        print.line("last")
