int count := 3
name := "Quidra"
println("Hello, {name}")

int[] original := [1, 2, 3]
copy := original
copy[0] = 9
println("original[0] = {original[0]}, copy[0] = {copy[0]}")

int total := 0
for value := original[]
    total += value
println("total = {total}")

for 0 <= int i < count
    if i == 0
        println("first")
    elif i < count - 1
        println("middle")
    else
        println("last")
