int count = 3
auto name = "Quidra"
print("Hello, {name}")
print(NL)

int[] original = [1, 2, 3]
int[] copy = original
copy[0] = 9
print("original[0] = {original[0]}, copy[0] = {copy[0]}")
print(NL)

int total = 0
for value in original
    total += value
print("total = {total}")
print(NL)

for i in range(0, count)
    if i == 0
        print("first")
        print(NL)
    elif i < count - 1
        print("middle")
        print(NL)
    else
        print("last")
        print(NL)
