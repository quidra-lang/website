import math

tensor<real32>{3, _, _} pixels := tensor.zeros<real32>([3, 64, 64])
tensor<real32>{1, _, _} bias := tensor.ones<real32>([1, 64, 64])
tensor<real32>{3, _, _} shifted := pixels + bias
sample := shifted[0, 10, 20].item()
print.line(sample)
shape := shifted.shape()
print.line(shape[0])
tensor<real32> a := tensor.ones([2, 3])
tensor<real32> b := tensor.ones([3, 2])
c := math.matmul(a, b)
print.line(c[0, 0].item())
print.line(math.mean(c).item())
