void inspect(const int[] values)
    total := 0
    for value := values[]
        total += value
    println("total {total}")

void .double_all(int[] &values)
    for &value := &values[]
        value = value * 2

int[] data := [1, 2, 3]
// Value parameters receive snapshots; mutable calls name the writable storage explicitly.
inspect(data)
.double_all(&data)
inspect(data)
println(data[2])
