void inspect(const int[] values)
    int total = 0
    for auto value = values[]
        total += value
    print("total {total}")
    print(NL)

void .double_all(int[] &values)
    for auto &value = &values[]
        value = value * 2

int[] data = [1, 2, 3]
// Value parameters receive snapshots; mutable calls name the writable storage explicitly.
inspect(data)
.double_all(&data)
inspect(data)
print(data[2])
print(NL)
