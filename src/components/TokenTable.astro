---
/**
 * A first-glance view of Quidra's surface: familiar forms first, with the
 * distinctive semantic rules introduced only where they become relevant.
 */
const rows = [
  { form: 'int count = 3', meaning: 'a typed binding with familiar declaration syntax' },
  { form: 'auto name = "Quidra"', meaning: 'infer a type when the initializer makes it unambiguous' },
  { form: 'for value in values', meaning: 'iterate directly over values' },
  { form: 'Point(3.0, 4.0)', meaning: 'construct a value by calling its type' },
  { form: '=', meaning: 'ordinary assignment has independent value semantics' },
  { form: '&x', meaning: 'observable aliasing is requested explicitly' },
  { form: 'T(value)', meaning: 'representation changes are explicit' },
  { form: 'and / or / not', meaning: 'boolean logic uses readable words' },
];
---

<dl class="token-table">
  {
    rows.map((row) => (
      <div class="token-row">
        <dt><code>{row.form}</code></dt>
        <dd>{row.meaning}</dd>
      </div>
    ))
  }
</dl>

<style>
  .token-table {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 48rem) { .token-table { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .token-table { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .token-row {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.2rem;
    background: var(--bg);
    align-content: start;
  }
  dt code {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent-text);
  }
  dd {
    margin: 0;
    color: var(--fg-2);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }
</style>
