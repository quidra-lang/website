---
import { formatScore, languageVersion, type LanguageAnalysis } from '../lib/benchmark-analysis';

interface Props {
  language: LanguageAnalysis;
  collapsed?: boolean;
  quidra?: boolean;
}

const { language, collapsed = false, quidra = false } = Astro.props;
const version = languageVersion(language.id);
const Panel = collapsed ? 'details' : 'article';
---

<Panel class:list={['evidence-panel', { 'is-quidra': quidra, 'is-expandable': collapsed }]}>
  {collapsed ? (
    <summary class="evidence-heading">
      <span class="language-name">{language.name}<span class="language-version"> {version}</span></span>
      <span class="language-score">{formatScore(language.score)}<span class="visually-hidden"> out of 100</span></span>
      <span class="expand-label">Evidence<span aria-hidden="true" class="expand-icon">+</span></span>
    </summary>
  ) : (
    <header class="evidence-heading">
      <h3 class="language-name">{language.name}<span class="language-version"> {version}</span></h3>
      <span class="language-score">{formatScore(language.score)}<span class="score-denominator"> / 100</span></span>
    </header>
  )}
  <div class="evidence-body">
    <div class="explanation">
      {language.explanation.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {language.facts.length > 0 && (
      <table class="evidence-facts">
        <caption>Recorded evidence</caption>
        <tbody>
          {language.facts.map((fact) => (
            <tr>
              <th scope="row">{fact.label}</th>
              <td>{fact.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    {language.caveats.length > 0 && (
      <div class="evidence-caveats">
        <p class="evidence-label">Evidence limits</p>
        {language.caveats.map((caveat) => <p>{caveat}</p>)}
      </div>
    )}
    <footer class="evidence-sources">
      <p class="evidence-label">Source evidence</p>
      <ul>
        {language.sources.map((source) => (
          <li><a href={source.url} rel="noopener">{source.label}</a></li>
        ))}
      </ul>
    </footer>
  </div>
</Panel>

<style>
  .evidence-panel {
    min-width: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .evidence-panel.is-quidra { border-top: 2px solid var(--accent); }
  .evidence-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-2);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .is-quidra .evidence-heading { background: var(--accent-soft); }
  .language-name { flex: 1 1 auto; font-size: 1rem; font-weight: 600; line-height: var(--leading-snug); }
  .language-version { margin-left: 0.55rem; color: var(--fg-2); font: 400 var(--text-xs) var(--font-mono); }
  .language-score { color: var(--fg); font: 500 1.1rem var(--font-mono); white-space: nowrap; }
  .score-denominator { color: var(--fg-2); font-size: var(--text-xs); font-weight: 400; }
  .evidence-body { display: grid; gap: 1.25rem; padding: 1.25rem; font-size: var(--text-sm); }
  .explanation { display: grid; gap: 0.75rem; color: var(--fg-2); }
  .explanation p, .evidence-caveats p { overflow-wrap: anywhere; }
  .evidence-facts { width: 100%; table-layout: fixed; font-size: 0.8125rem; }
  .evidence-facts caption, .evidence-label {
    text-align: left;
    color: var(--fg-2);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .evidence-facts caption { padding-bottom: 0.45rem; }
  .evidence-facts th, .evidence-facts td {
    padding: 0.5rem 0;
    border-top: 1px solid var(--rule);
    vertical-align: top;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .evidence-facts th { width: 42%; padding-right: 1rem; font-weight: 400; color: var(--fg-2); }
  .evidence-facts td { color: var(--fg); font-variant-numeric: tabular-nums; white-space: pre-wrap; }
  .evidence-caveats { display: grid; gap: 0.5rem; padding-left: 0.85rem; border-left: 2px solid var(--rule-strong); color: var(--fg-2); }
  .evidence-sources { display: grid; gap: 0.35rem; padding-top: 0.85rem; border-top: 1px solid var(--rule); }
  .evidence-sources ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; list-style: none; font-size: 0.8125rem; }
  .evidence-sources a { display: inline-block; padding-block: 0.15rem; overflow-wrap: anywhere; }
  .is-expandable:not([open]) .evidence-heading { border-bottom: 0; border-radius: var(--radius); }
  .is-expandable summary:hover { background: var(--bg-inset); }
  .is-expandable summary:focus-visible { outline-offset: 3px; }
  .expand-label { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--accent-text); font-size: var(--text-xs); }
  .expand-icon { width: 0.8rem; font: 500 1rem var(--font-mono); }
  .is-expandable[open] .expand-icon { font-size: 0; }
  .is-expandable[open] .expand-icon::after { content: '−'; font-size: 1rem; }
  @media (max-width: 30rem) {
    .evidence-heading { padding: 0.85rem 1rem; }
    .evidence-body { padding: 1rem; }
    .evidence-facts th { width: 40%; padding-right: 0.65rem; }
  }
  @media print {
    .evidence-panel { break-inside: avoid; }
    .is-expandable::details-content { display: block; }
    .expand-label { display: none; }
  }
</style>
