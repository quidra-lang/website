---
import Icon from './Icon.astro';
/**
 * Light/dark switch. The page follows the system preference by default; a
 * choice is stored in localStorage and applied before first paint by the
 * inline script in Base.astro. Hidden until JavaScript enables it.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <Icon name="sun" class="icon-sun" />
  <Icon name="moon" class="icon-moon" />
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (button) {
    const query = window.matchMedia('(prefers-color-scheme: dark)');
    const current = () => root.dataset.theme ?? (query.matches ? 'dark' : 'light');
    const describe = () => {
      button.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    };
    const applyThemeColor = (theme: string) => {
      for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.setAttribute('media', 'not all');
      const meta = document.createElement('meta');
      meta.name = 'theme-color';
      meta.content = theme === 'dark' ? '#0b0e14' : '#ffffff';
      document.head.append(meta);
    };
    describe();
    query.addEventListener('change', describe);
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      applyThemeColor(next);
      describe();
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice still applies for this page */
      }
    });
  }
</script>
