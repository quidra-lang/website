---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { links, site } from '../config/site';

/**
 * Documentation index. The reference documentation is maintained in the
 * quidra-lang/quidra repository beside the compiler and verified against it
 * in CI; this page is the map. It is designed to move to docs.quidra-lang.com
 * without changing any other page.
 */
const description =
  'The Quidra documentation: language semantics, grammar, numeric types, the LLM guide, compiler architecture, diagnostics, structured patches and package management.';

const groups = [
  {
    title: 'Language',
    items: [
      {
        name: 'Language semantics',
        href: links.docs.language,
        path: 'docs/spec/language.md',
        text: 'The normative description of Quidra: types, bindings and definite initialization, functions, classes, generics, references and const authority, unions and match, tensors and device placement, autograd and standard namespaces, package boundaries, and the C FFI.',
      },
      {
        name: 'Grammar',
        href: links.docs.grammar,
        path: 'docs/spec/grammar.ebnf',
        text: 'The EBNF grammar of Quidra source, including the lexical constraints on numeric and string literals and the static constraints the frontend enforces.',
      },
      {
        name: 'Numeric types and bin',
        href: links.docs.numericAndBin,
        path: 'docs/spec/numeric-and-bin.md',
        text: 'Fixed-width integers, floating-point types, exact bigint and bigreal, explicit conversion rules, fixed-width bitwise operators and the packed binary type bin.',
      },
    ],
  },
  {
    title: 'Working with the compiler',
    items: [
      {
        name: 'LLM guide',
        href: links.docs.llmGuide,
        path: 'docs/spec/llm-guide.md',
        text: 'The canonical generation rules for writing Quidra, for language models and people alike: numbered rules on what to write and what not to invent, a complete example and the verification commands.',
      },
      {
        name: 'Diagnostics',
        href: links.docs.diagnostics,
        path: 'docs/spec/diagnostics.md',
        text: 'Every compiler diagnostic code with its meaning and typical correction, the JSON output of quidra check, and the deterministic runtime safety failures.',
      },
      {
        name: 'Source patch schema',
        href: links.docs.patchSchema,
        path: 'docs/spec/patch-schema.md',
        text: 'The revision- and hash-checked structural patch format consumed by quidra patch, for tools that edit programs as checked transactions rather than text.',
      },
      {
        name: 'Architecture',
        href: links.docs.architecture,
        path: 'docs/spec/architecture.md',
        text: 'How the compiler is built: phases and lowering invariants, core contracts, format versions, the WebAssembly frontend boundary and the native runtime boundary.',
      },
    ],
  },
  {
    title: 'Project',
    items: [
      {
        name: 'Package management',
        href: links.docs.packages,
        path: 'docs/packages.md',
        text: 'Installing released packages from immutable tags, the quidra.package manifest, project.toml metadata, lockfiles and local development packages.',
      },
      {
        name: 'Development and release workflow',
        href: links.docs.development,
        path: 'docs/development.md',
        text: 'Branch roles, versioning, the single source of truth for project metadata, the core release procedure and how first-party libraries are released after it.',
      },
      {
        name: 'Examples',
        href: links.docs.examples,
        path: 'examples/',
        text: 'Small complete programs kept in the compiler repository and exercised by its test suite.',
      },
      {
        name: 'README',
        href: links.docs.readme,
        path: 'README.md',
        text: 'The design thesis, the design laws derived from semantic compression, the build instructions and the CLI reference, in one document.',
      },
    ],
  },
];

const describe = `quidra describe
quidra describe grammar
quidra describe patch-schema
quidra describe llm`;
---

<Base title="Documentation" description={description}>
  <section class="section docs-hero">
    <div class="container">
      <p class="eyebrow"><b>Docs</b> / Quidra {site.quidraVersion}</p>
      <h1>Documentation</h1>
      <p class="lede">
        Quidra's reference documentation lives beside the compiler in the <a href={links.core} rel="noopener">quidra-lang/quidra</a> repository,
        where its examples are verified by the compiler's own test suite. This page is the map.
      </p>
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="section docs-group">
        <div class="container">
          <h2 class="group-title">{group.title}</h2>
          <ul class="doc-list">
            {group.items.map((item) => (
              <li class="doc-card">
                <span class="doc-path">{item.path}</span>
                <a class="doc-name" href={item.href} rel="noopener">
                  {item.name}
                  <Icon name="external" />
                </a>
                <span class="doc-text">{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container docs-machine">
      <div>
        <p class="eyebrow">Machine-readable</p>
        <h2>The compiler documents itself</h2>
        <p class="lede">
          <code>quidra describe</code> prints the language and tooling contracts as JSON: the compilation pipeline, the
          current types and built-ins, the specification documents and the format versions. The grammar, the patch schema
          and the LLM guide are available the same way.
        </p>
      </div>
      <CodeBlock code={describe} lang="bash" />
    </div>
  </section>
</Base>

<style>
  .docs-hero { border-top: 0; padding-bottom: clamp(2rem, 4vw, 3rem); }
  .docs-hero .container { display: grid; gap: 1rem; }
  h1 { font-size: var(--text-2xl); }
  .docs-group { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .group-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 1.25rem;
  }
  .doc-list {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 48rem) { .doc-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .doc-card {
    position: relative;
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.35rem 1.5rem 1.5rem;
    background: var(--bg);
    color: var(--fg);
    transition: background-color var(--dur) var(--ease);
  }
  .doc-card:hover { background: var(--bg-2); }
  .doc-card:has(.doc-name:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  .doc-path { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--fg-3); }
  .doc-name { display: inline-flex; align-items: center; gap: 0.4rem; width: fit-content; font-weight: 600; font-size: var(--text-md); letter-spacing: var(--tracking-tight); color: var(--fg); text-decoration: none; }
  .doc-name::after { content: ''; position: absolute; inset: 0; }
  .doc-name:focus-visible { outline: none; }
  .doc-name :global(svg) { width: 0.8rem; height: 0.8rem; color: var(--fg-3); }
  .doc-card:hover .doc-name { text-decoration: underline; text-underline-offset: 0.16em; }
  .doc-text { color: var(--fg-2); font-size: var(--text-sm); }
  .docs-machine { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 64rem) { .docs-machine { grid-template-columns: 1.1fr 1fr; gap: 4rem; } }
  .docs-machine > div { display: grid; gap: 1rem; }
</style>
