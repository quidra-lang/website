---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on quidra-lang.com." noindex>
  <section class="section not-found">
    <div class="container">
      <p class="eyebrow"><b>404</b> / not found</p>
      <h1>Nothing at this path.</h1>
      <p class="lede">The address may be out of date. Absence is normal, and it is handled explicitly.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to the home page</a>
        <a class="btn btn-secondary" href="/docs/">Browse the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found { border-top: 0; min-height: 60vh; display: grid; align-items: center; }
  .not-found .container { display: grid; gap: 1.25rem; }
  h1 { font-size: var(--text-2xl); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
</style>
